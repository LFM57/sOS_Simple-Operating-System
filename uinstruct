# sOS Over-The-Air (OTA) Update Instructions
# Format: standard shell commands separated by newlines or semicolons ';'
# [ip] or [server] is automatically replaced with the update server's host:port

mkdir /bin/
chmod 70 /bin
wget [ip]/app.sos /bin/app.sos
chmod 70 /bin/app.sos
wget [ip]/paint.sos /bin/paint.sos
chmod 70 /bin/paint.sos
wget [ip]/files.sos /bin/files.sos
chmod 70 /bin/files.sos
wget [ip]/sysmon.sos /bin/sysmon.sos
chmod 70 /bin/sysmon.sos
wget [ip]/edit.sos /bin/edit.sos
chmod 70 /bin/edit.sos
wget [ip]/kernel.bin /kernel.bin
